# =============================
# DATABASE (Neon PostgreSQL)
# =============================
# Format Neon: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/berubat_db?sslmode=require"

# =============================
# NEXTAUTH
# =============================
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
AUTH_URL="https://your-domain.vercel.app"
PAYLOAD_SECRET=""

# =============================
# WHATSAPP NOTIFICATION (Fonnte)
# =============================
# Daftar di https://fonnte.com — ambil token dari dashboard
WA_API_TOKEN=""
# Nomor WA owner tanpa + dan tanpa 0 di depan, contoh: 6285817807393
WA_OWNER_NUMBER="6285817807393"

# =============================
# EMAIL (Resend) — opsional
# =============================
RESEND_API_KEY=""
